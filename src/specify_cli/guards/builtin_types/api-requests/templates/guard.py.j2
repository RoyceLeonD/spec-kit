#!/usr/bin/env python3
import json
import sys
from pathlib import Path

DEFAULT_PARAMS = {{ default_params_repr }}
PROJECT_ROOT = Path(__file__).resolve().parents[3]


def main() -> int:
    raw = sys.argv[1] if len(sys.argv) > 1 else "{}"
    overrides = json.loads(raw)
    params = dict(DEFAULT_PARAMS)
    params.update(overrides)
    manifest = PROJECT_ROOT / params.get("manifest_path", ".specify/api-requests.yaml")
    passed = manifest.exists()
    print(json.dumps({
        "passed": passed,
        "analysis": "API request manifest found" if passed else f"Missing API request manifest: {manifest.relative_to(PROJECT_ROOT)}",
        "details": {"manifest": str(manifest)},
    }))
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
