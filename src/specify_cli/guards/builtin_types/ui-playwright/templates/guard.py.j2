#!/usr/bin/env python3
import json
import sys
from pathlib import Path

DEFAULT_PARAMS = {{ default_params_repr }}
PROJECT_ROOT = Path(__file__).resolve().parents[3]


def main() -> int:
    raw = sys.argv[1] if len(sys.argv) > 1 else "{}"
    overrides = json.loads(raw)
    params = dict(DEFAULT_PARAMS)
    params.update(overrides)
    paths = [PROJECT_ROOT / item for item in (params.get("spec_paths") or [])]
    existing = [str(path) for path in paths if path.exists()]
    passed = bool(existing)
    print(json.dumps({
        "passed": passed,
        "analysis": "Playwright guard found matching spec paths" if passed else "No Playwright spec paths found",
        "details": {"existing": existing},
    }))
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
